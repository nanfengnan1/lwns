# Managed by lwns directory installer v1
[Unit]
Description=lwns - Linux Web Network Simulator
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/lwns
WorkingDirectory=/var/lib/lwns
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
