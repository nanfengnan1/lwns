# Requires the prebuilt native SDN image; the offline .lwns includes the result.
ARG BASE_IMAGE=sdn-agent:alpine
FROM ${BASE_IMAGE}
USER root
RUN python3 -c 'from pathlib import Path; p=Path("/usr/local/bin/sdn-device"); p.write_text('"'"'#!/usr/bin/env python3\n"""LWNS lifecycle wrapper; application databases retain their native persistence."""\nimport json\nimport os\nfrom pathlib import Path\nimport secrets\nimport signal\nimport subprocess\nimport sys\nimport time\n\nROLE = \'"'"'sdn-agent\'"'"'\nCONFIG = Path(\'"'"'/etc/\'"'"' + ROLE + \'"'"'/\'"'"' + {\'"'"'sdn-agent\'"'"': \'"'"'agent\'"'"', \'"'"'sdn-controller\'"'"': \'"'"'controller\'"'"', \'"'"'sdn-web\'"'"': \'"'"'web\'"'"'}[ROLE] + \'"'"'.conf\'"'"')\nRUNTIME = Path(\'"'"'/run/lwns-sdn\'"'"')\nstopping = False\n\ndef atomic(path, value):\n    temporary = path.with_name(path.name + \'"'"'.tmp\'"'"')\n    with temporary.open(\'"'"'w\'"'"') as stream:\n        os.chmod(temporary, 0o600)\n        json.dump(value, stream, indent=2)\n        stream.write(\'"'"'\\n\'"'"')\n        stream.flush()\n        os.fsync(stream.fileno())\n    os.replace(temporary, path)\n\ndef initialize():\n    if ROLE == \'"'"'sdn-web\'"'"' and not CONFIG.exists():\n        atomic(CONFIG, {\'"'"'controller\'"'"': \'"'"'127.0.0.1:19090\'"'"', \'"'"'insecure\'"'"': True,\n                        \'"'"'adminToken\'"'"': secrets.token_hex(24), \'"'"'viewerToken\'"'"': secrets.token_hex(24)})\n    config = json.loads(CONFIG.read_text())\n    changed = False\n    section = config.get(\'"'"'agent\'"'"' if ROLE == \'"'"'sdn-agent\'"'"' else \'"'"'controller\'"'"', {})\n    if ROLE != \'"'"'sdn-web\'"'"':\n        for key in ([\'"'"'token\'"'"'] if ROLE == \'"'"'sdn-agent\'"'"' else [\'"'"'adminToken\'"'"', \'"'"'viewerToken\'"'"', \'"'"'agentToken\'"'"']):\n            if not section.get(key):\n                section[key] = secrets.token_hex(24)\n                changed = True\n    if changed:\n        atomic(CONFIG, config)\n    os.chmod(CONFIG, 0o600)\n    return validate()\n\ndef run(command, **kwargs):\n    return subprocess.run(command, check=True, timeout=kwargs.pop(\'"'"'timeout\'"'"', 30), **kwargs)\n\ndef validate():\n    config = json.loads(CONFIG.read_text())\n    if ROLE != \'"'"'sdn-web\'"'"':\n        run([ROLE, \'"'"'-config\'"'"', str(CONFIG), \'"'"'-check-config\'"'"'], stdout=subprocess.DEVNULL)\n    else:\n        allowed = {\'"'"'controller\'"'"', \'"'"'insecure\'"'"', \'"'"'controllerCA\'"'"', \'"'"'adminToken\'"'"', \'"'"'viewerToken\'"'"'}\n        if set(config) - allowed or not isinstance(config.get(\'"'"'controller\'"'"'), str) or not config[\'"'"'controller\'"'"']:\n            raise ValueError(\'"'"'invalid Web configuration fields or controller endpoint\'"'"')\n        if type(config.get(\'"'"'insecure\'"'"')) is not bool:\n            raise ValueError(\'"'"'Web insecure must be boolean\'"'"')\n        if not config[\'"'"'insecure\'"'"'] and not config.get(\'"'"'controllerCA\'"'"'):\n            raise ValueError(\'"'"'controllerCA is required for TLS to Controller\'"'"')\n        if any(not isinstance(config.get(k), str) or len(config[k]) < 16 for k in (\'"'"'adminToken\'"'"', \'"'"'viewerToken\'"'"')):\n            raise ValueError(\'"'"'Web admin/viewer tokens must have at least 16 characters\'"'"')\n        if config[\'"'"'adminToken\'"'"'] == config[\'"'"'viewerToken\'"'"']:\n            raise ValueError(\'"'"'Web admin/viewer tokens must differ\'"'"')\n    return config\n\ndef probe():\n    command = {\'"'"'sdn-agent\'"'"': [\'"'"'/usr/local/bin/sdn-agent-healthcheck\'"'"'],\n               \'"'"'sdn-controller\'"'"': [\'"'"'python3\'"'"', \'"'"'/usr/local/lib/sdn-controller/supervisor.py\'"'"', \'"'"'--healthcheck\'"'"'],\n               \'"'"'sdn-web\'"'"': [\'"'"'python3\'"'"', \'"'"'/usr/local/lib/sdn-web/supervisor.py\'"'"', \'"'"'--healthcheck\'"'"']}[ROLE]\n    run(command, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=12)\n\ndef launch():\n    config = validate()\n    env = os.environ.copy()\n    options = {}\n    if ROLE == \'"'"'sdn-agent\'"'"':\n        command = [\'"'"'/usr/local/bin/sdn-agent-entrypoint\'"'"', \'"'"'-config\'"'"', str(CONFIG)]\n    elif ROLE == \'"'"'sdn-controller\'"'"':\n        command = [\'"'"'python3\'"'"', \'"'"'/usr/local/lib/sdn-controller/supervisor.py\'"'"', \'"'"'-config\'"'"', str(CONFIG)]\n    else:\n        # Gateway authentication is configured at runtime, never baked into the image.\n        env.update(SDN_ADMIN_TOKEN=config[\'"'"'adminToken\'"'"'], SDN_VIEWER_TOKEN=config[\'"'"'viewerToken\'"'"'])\n        command = [\'"'"'python3\'"'"', \'"'"'/usr/local/lib/sdn-web/supervisor.py\'"'"', \'"'"'-controller\'"'"', config[\'"'"'controller\'"'"']]\n        if config[\'"'"'insecure\'"'"']:\n            command.append(\'"'"'-insecure\'"'"')\n        else:\n            # Bundle\'"'"'s internal HTTP requires -insecure; -controller-ca alone does\n            # not enable upstream TLS. Keep this package explicitly lab-only.\n            raise ValueError(\'"'"'this bundled device requires insecure=true for isolated labs\'"'"')\n        import pwd\n        account = pwd.getpwnam(\'"'"'nginx\'"'"')\n        options.update(user=account.pw_uid, group=account.pw_gid)\n    return subprocess.Popen(command, env=env, **options)\n\ndef stop(child):\n    if child and child.poll() is None:\n        child.terminate()\n        try:\n            child.wait(timeout=180)\n        except subprocess.TimeoutExpired:\n            child.kill()\n            child.wait(timeout=10)\n\ndef start():\n    global stopping\n    initialize()\n    RUNTIME.mkdir(mode=0o700, exist_ok=True)\n    def signal_stop(_sig, _frame):\n        global stopping\n        stopping = True\n    signal.signal(signal.SIGTERM, signal_stop)\n    signal.signal(signal.SIGINT, signal_stop)\n    child = None\n    try:\n        while not stopping:\n            request = (RUNTIME / \'"'"'restart.json\'"'"')\n            generation = request.read_text() if request.exists() else \'"'"'initial\'"'"'\n            child = launch()\n            atomic(RUNTIME / \'"'"'process.json\'"'"', {\'"'"'pid\'"'"': child.pid, \'"'"'generation\'"'"': generation})\n            while not stopping and child.poll() is None:\n                if request.exists() and request.read_text() != generation:\n                    break\n                time.sleep(0.2)\n            if not stopping and child.poll() is not None:\n                raise RuntimeError(\'"'"'native service exited: \'"'"' + str(child.returncode))\n            stop(child)\n            child = None\n    finally:\n        stop(child)\n        (RUNTIME / \'"'"'process.json\'"'"').unlink(missing_ok=True)\n\ndef ready():\n    process = json.loads((RUNTIME / \'"'"'process.json\'"'"').read_text())\n    os.kill(process[\'"'"'pid\'"'"'], 0)\n    request = RUNTIME / \'"'"'restart.json\'"'"'\n    if request.exists() and process[\'"'"'generation\'"'"'] != request.read_text():\n        raise RuntimeError(\'"'"'service is restarting\'"'"')\n    probe()\n\ndef restart():\n    validate()\n    if not (RUNTIME / \'"'"'process.json\'"'"').exists():\n        raise RuntimeError(\'"'"'device supervisor is not running\'"'"')\n    request = RUNTIME / \'"'"'restart.json\'"'"'\n    atomic(request, {\'"'"'request\'"'"': secrets.token_hex(16)})\n    deadline = time.monotonic() + 240\n    while time.monotonic() < deadline:\n        try:\n            ready()\n            print(\'"'"'Services restarted; container interfaces retained.\'"'"')\n            return\n        except (OSError, ValueError, RuntimeError, subprocess.SubprocessError):\n            time.sleep(0.5)\n    raise RuntimeError(\'"'"'restart timed out; inspect docker logs\'"'"')\n\ndef save():\n    ready()\n    validate()\n    if ROLE == \'"'"'sdn-agent\'"'"':\n        config = json.loads(CONFIG.read_text())\n        if not config[\'"'"'redis\'"'"'][\'"'"'enabled\'"'"']:\n            raise ValueError(\'"'"'this device save action requires bundled Redis\'"'"')\n        run([\'"'"'vtysh\'"'"', \'"'"'-w\'"'"'])\n        run([\'"'"'redis-cli\'"'"', \'"'"'-h\'"'"', config[\'"'"'redis\'"'"'][\'"'"'bind\'"'"'], \'"'"'-p\'"'"', str(config[\'"'"'redis\'"'"'][\'"'"'port\'"'"']), \'"'"'SAVE\'"'"'])\n    elif ROLE == \'"'"'sdn-controller\'"'"':\n        config = json.loads(CONFIG.read_text())\n        if not config[\'"'"'etcd\'"'"'][\'"'"'enabled\'"'"']:\n            raise ValueError(\'"'"'this device save action requires bundled etcd\'"'"')\n        temporary = CONFIG.parent / (\'"'"'snapshot-\'"'"' + secrets.token_hex(6) + \'"'"'.db\'"'"')\n        try:\n            run([\'"'"'etcdctl\'"'"', \'"'"'--endpoints\'"'"', \'"'"'http://127.0.0.1:\'"'"' + str(config[\'"'"'etcd\'"'"'][\'"'"'clientPort\'"'"']),\n                 \'"'"'--command-timeout=30s\'"'"', \'"'"'snapshot\'"'"', \'"'"'save\'"'"', str(temporary)], timeout=40)\n            os.replace(temporary, CONFIG.parent / \'"'"'etcd-snapshot.db\'"'"')\n        finally:\n            temporary.unlink(missing_ok=True)\n    os.sync()\n    print(\'"'"'Native configuration persisted. Network reconstruction is still subject to REL-004.\'"'"')\n\ndef main():\n    command = sys.argv[1] if len(sys.argv) == 2 else \'"'"'help\'"'"'\n    handlers = {\'"'"'init\'"'"': initialize, \'"'"'start\'"'"': start, \'"'"'ready\'"'"': ready, \'"'"'restart\'"'"': restart, \'"'"'save\'"'"': save, \'"'"'check\'"'"': validate}\n    if command not in handlers:\n        print(\'"'"'sdn-device init|start|ready|restart|save|check; configuration: \'"'"' + str(CONFIG))\n        return 0 if command == \'"'"'help\'"'"' else 2\n    handlers[command]()\n    return 0\n\nif __name__ == \'"'"'__main__\'"'"':\n    try:\n        sys.exit(main())\n    except (OSError, ValueError, RuntimeError, subprocess.SubprocessError) as error:\n        # Avoid including configuration or environment contents in logs.\n        print(\'"'"'sdn-device failed: \'"'"' + type(error).__name__, file=sys.stderr)\n        sys.exit(1)\n'"'"'); p.chmod(0o755); Path('"'"'/etc/sdn-agent'"'"').mkdir(parents=True,exist_ok=True)'
HEALTHCHECK --interval=10s --timeout=15s --start-period=120s --retries=3 CMD ["sdn-device", "ready"]
ENTRYPOINT ["/sbin/tini", "--", "sdn-device"]
CMD ["start"]
