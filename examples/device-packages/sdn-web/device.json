{
  "schema_version": 1,
  "id": "lwns-sdn-web",
  "version": "1.0",
  "name": "sdn-web",
  "category": "host",
  "description": "隔离实验设备；首次启动生成独立凭据，需手工配置管理地址及匹配凭据。保存原生配置和数据库；Linux 网络重建自动恢复尚未实现（REL-004）。",
  "image": "lwns/sdn-web:1.0",
  "source": {
    "type": "dockerfile",
    "path": "Dockerfile"
  },
  "profile": "generic",
  "platform": "linux/amd64",
  "console": [
    "/bin/sh",
    "-i"
  ],
  "persistent_dirs": [
    {
      "id": "config",
      "target": "/etc/sdn-web",
      "initialize_from": "image",
      "owner": "0:0",
      "mode": "rw",
      "permissions": "0700"
    }
  ],
  "startup": {
    "phase": "after_links",
    "prepare": [
      {
        "exec": [
          "sdn-device",
          "init"
        ]
      }
    ],
    "service": {
      "exec": [
        "sdn-device",
        "start"
      ]
    },
    "config_files": [
      "/etc/sdn-web/web.conf"
    ],
    "ready": {
      "exec": [
        "sdn-device",
        "ready"
      ],
      "timeout_seconds": 120,
      "interval_seconds": 1
    }
  },
  "actions": {
    "save_config": {
      "exec": [
        "sdn-device",
        "save"
      ],
      "user": "0",
      "timeout_seconds": 90,
      "expected_files": [
        "/etc/sdn-web/web.conf"
      ]
    }
  }
}
